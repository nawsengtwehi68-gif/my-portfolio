<style>
:root{--bg:#F2F5F3;--surface:#FFFFFF;--ink:#13203A;--muted:#55627A;--line:#D5DCE0;--accent:#2B55E0;--dot:#E8912B;--on-accent:#fff;color-scheme:light;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0E1524;--surface:#16203A;--ink:#EAF0FA;--muted:#9AA8C4;--line:#27345A;--accent:#7C9BFF;--dot:#F5A94A;--on-accent:#0E1524;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0E1524;--surface:#16203A;--ink:#EAF0FA;--muted:#9AA8C4;--line:#27345A;--accent:#7C9BFF;--dot:#F5A94A;--on-accent:#0E1524;color-scheme:dark}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 70px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.65 "IBM Plex Sans",system-ui,sans-serif;overflow-x:hidden}
h1,h2,h3{font-family:"Bricolage Grotesque","Segoe UI",system-ui,sans-serif;line-height:1.1;margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.wrap{max-width:1080px;margin:0 auto;padding:0 clamp(1.1rem,4vw,2rem)}
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:30}
.bar{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:60px}
.logo{font:800 1.15rem "Bricolage Grotesque",sans-serif;text-decoration:none}
nav{display:flex;gap:1.4rem}
nav a{text-decoration:none;color:var(--muted);font-weight:500;font-size:.95rem}
nav a:hover{color:var(--ink)}
.btn{display:inline-block;background:var(--accent);color:var(--on-accent);padding:.8rem 1.3rem;border-radius:8px;text-decoration:none;font-weight:500}
.btn.alt{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}
.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:2.5rem;align-items:center;padding:clamp(2.5rem,7vw,5.5rem) 0}
.hero h1{font-size:clamp(2.6rem,7.5vw,5.2rem);font-weight:800;letter-spacing:-.03em}
.role{font:700 clamp(1.1rem,2.4vw,1.5rem) "Bricolage Grotesque",sans-serif;color:var(--accent);margin:1rem 0 .6rem}
.hero p{max-width:34rem;color:var(--muted);margin:0 0 1.6rem}
.cta{display:flex;flex-wrap:wrap;gap:.8rem}
.plot{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:.8rem}
.plot svg{display:block;width:100%;height:auto}
.plot figcaption{font-size:.85rem;color:var(--muted);padding:.4rem .4rem 0}
.grid line{stroke:var(--line);stroke-width:1}
.axis{stroke:var(--muted);stroke-width:1.5}
.pt{fill:var(--dot)}
.fit{stroke:var(--accent);stroke-width:3.5;fill:none;stroke-linecap:round;stroke-dasharray:420;stroke-dashoffset:420;animation:draw 1.8s .4s ease-out forwards}
@keyframes draw{to{stroke-dashoffset:0}}
@media (prefers-reduced-motion:reduce){.fit{animation:none;stroke-dashoffset:0}html{scroll-behavior:auto}}
section{padding:clamp(2.5rem,6vw,4.5rem) 0;border-top:1px solid var(--line)}
h2{font-size:clamp(1.8rem,4.5vw,2.6rem);font-weight:700;margin-bottom:1.6rem;letter-spacing:-.02em}
.about{display:grid;grid-template-columns:260px 1fr;gap:2.5rem;align-items:start}
.about img{width:100%;aspect-ratio:1;object-fit:cover;border-radius:14px;border:1px solid var(--line)}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:1rem;margin-top:1.4rem}
.facts div{border-left:3px solid var(--accent);padding-left:.8rem}
.facts b{display:block;font-weight:500;color:var(--muted);font-size:.85rem}
.skills{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:1rem}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:1.3rem}
.card h3{font-size:1.2rem;margin-bottom:.6rem}
.tags{display:flex;flex-wrap:wrap;gap:.45rem;margin:0;padding:0;list-style:none}
.tags li{background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:.2rem .75rem;font-size:.9rem}
.proj{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem}
.proj p{color:var(--muted);margin:.3rem 0 .9rem;font-size:.98rem}
.note{color:var(--muted);font-size:.9rem;margin-top:1rem}
.contact{text-align:left}
.contact a.mail{font:700 clamp(1.15rem,4.6vw,2.2rem) "Bricolage Grotesque",sans-serif;color:var(--accent);word-break:break-all}
footer{padding:2rem 0;border-top:1px solid var(--line);color:var(--muted);font-size:.9rem}
@media (max-width:820px){.hero,.about{grid-template-columns:1fr}.about img{max-width:260px}nav{display:none}}

.motivation-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}
.motivation-photo{margin:0;background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.motivation-photo img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}
.motivation-photo figcaption{padding:.8rem 1rem;color:var(--muted);font-size:.92rem}
.motivation-quote{margin-top:1.3rem;background:var(--surface);border-left:4px solid var(--accent);border-radius:10px;padding:1.2rem 1.4rem}
.motivation-quote p{margin:.35rem 0;color:var(--muted)}
@media(max-width:650px){.motivation-grid{grid-template-columns:1fr}}

</style>
</head>
